# x86_64 live ISO (in addition to bzImage + rootfs.ext2 QEMU path).
# Boot smoke uses QEMU -cdrom (not -kernel). Fail-closed: no default routing.
# Buildroot docs: BIOS GRUB on ISO must use boot partition "cd" + iso9660 module.
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BOOT_PARTITION="cd"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat iso9660 squash4 part_msdos part_gpt normal biosdisk"
