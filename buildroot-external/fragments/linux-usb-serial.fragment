# Lab USB-serial for Waveshare C (FTDI) and Waveshare B / WCH CH343.
# Fragment is merged via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES (absolute path).
# Unknown symbols are dropped by merge_config/olddefconfig — do not claim a
# driver PASS without by-id evidence on the target kernel.

CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CH343=y
