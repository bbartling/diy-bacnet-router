# FTDI USB-UART: default latency_timer=16 ms causes ~3 s bacpypes/Workbench
# APDU retries on BIP↔MS/TP confirmed reads (diy-bacnet-router #66).
# Force 1 ms for lab RS-485 adapters (Waveshare USB-TO-RS485-C / FT232R).
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{device/latency_timer}="1"
