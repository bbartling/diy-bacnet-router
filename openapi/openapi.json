{
  "openapi": "3.1.0",
  "info": {
    "title": "DIY BACnet Router Management API",
    "version": "0.0.1",
    "description": "Read-only LAN management API for the appliance dashboard. No URL versioning — the appliance ships as one unit. BACnet forwarding is not yet enabled."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/healthz": { "get": { "summary": "Management and data-plane health", "responses": { "200": { "description": "Health snapshot" } } } },
    "/api/status": { "get": { "summary": "Build and runtime status", "responses": { "200": { "description": "Status" } } } },
    "/api/capabilities": { "get": { "summary": "Truthful implementation capability matrix", "responses": { "200": { "description": "Capabilities" } } } },
    "/api/config/effective": { "get": { "summary": "Effective non-secret configuration", "responses": { "200": { "description": "Configuration" } } } },
    "/api/metrics/snapshot": { "get": { "summary": "Current aggregate router and Linux metrics", "responses": { "200": { "description": "Metrics snapshot" } } } },
    "/api/ws/metrics": { "get": { "summary": "WebSocket aggregate metrics stream (MS/TP trunk health, B/IP counters)", "responses": { "101": { "description": "WebSocket upgrade" } } } },
    "/metrics": { "get": { "summary": "Prometheus text exposition", "responses": { "200": { "description": "Prometheus metrics" } } } }
  }
}
