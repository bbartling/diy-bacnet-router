# Copy to config/vm.env and fill in (config/vm.env is gitignored).
# Used by scripts/vm-ensure.ps1 and vm-authorize-key.ps1 for VirtualBox ubuntu2.

VM_SSH_USER=ben
VM_SSH_HOST=127.0.0.1
VM_SSH_PORT=2222
VM_SSH_PASSWORD=

