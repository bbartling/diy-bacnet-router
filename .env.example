# Copy to .env and customize. docker-compose reads this via env_file.
#
# Sidecar startup only — field device targets (Modbus host, BACnet device IDs) are
# passed in REST POST bodies by scripts/bench_test.sh (see scripts/bench.env.example).
#
# Every OPENFDD_FIELDBUS_* var falls back to the legacy RUSTY_GATEWAY_* name;
# when both are set, OPENFDD_FIELDBUS_* wins.

# --- Auth / HTTP ---
OPENFDD_FIELDBUS_API_KEY=change-me-use-openssl-rand-hex-32
OPENFDD_FIELDBUS_HTTP_HOST=0.0.0.0
OPENFDD_FIELDBUS_HTTP_PORT=8080
OPENFDD_FIELDBUS_OPENAPI=1
# Optional: public URL shown in Swagger for "Try it out" (e.g. http://192.168.204.55:8080)
# OPENFDD_FIELDBUS_SWAGGER_SERVERS_URL=http://192.168.204.55:8080

# --- BACnet (sidecar NIC — client source IP + directed broadcast) ---
OPENFDD_FIELDBUS_BIND=192.168.204.55
OPENFDD_FIELDBUS_BACNET_PORT=47808
# OPENFDD_FIELDBUS_BROADCAST=192.168.204.255

# --- Background poll engine ---
OPENFDD_FIELDBUS_POLL_ENABLED=1
OPENFDD_FIELDBUS_POLL_INTERVAL_SECS=60

# --- Local dev (path to config/; Docker sets /app/config automatically) ---
# OPENFDD_FIELDBUS_CONFIG_DIR=config

# --- Build metadata (shown on /health and /api/health) ---
OPENFDD_FIELDBUS_GIT_SHA=dev

# --- Haystack upstream (read-only client — restart required to change) ---
# Bench Niagara nHaystack: HTTP Basic + self-signed TLS
HAYSTACK_BASE_URL=https://192.168.204.11/haystack
HAYSTACK_USER=open_fdd
HAYSTACK_PASS=change-me
HAYSTACK_AUTH_MODE=basic

# Local rusty-haystack demo (SCRAM): http://127.0.0.1:8081  user admin  HAYSTACK_AUTH_MODE=scram